    "help.accessibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About “%@”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”说明"
          }
        }
      }
    },
    "help.prefill" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rate at which the model processes the input, including earlier conversation, in tokens per second. A higher value means a shorter wait before the response begins."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型处理输入内容（含历史对话）的速度，单位为 token/秒。数值越高，提问后开始输出回答前的等待时间越短。"
          }
        }
      }
    },
    "help.decode" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rate at which the model generates the response, in tokens per second. One token corresponds to approximately one Chinese character or part of an English word."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型生成回答内容的速度，单位为 token/秒。1 个 token 约相当于 1 个汉字或半个英文单词。"
          }
        }
      }
    },
    "help.context" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, previous questions and responses in the current conversation are included as context, allowing follow-up questions. When disabled, each question is processed independently, which is faster and uses less memory."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，当前对话中先前的问答将作为上下文提供给模型，支持基于上文的追问。关闭后，每个问题均独立处理，速度更快，内存占用更低。"
          }
        }
      }
    },
    "help.contextLimit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum amount of content, in tokens, that the model processes in one request, including both input and output. A larger value retains longer conversations but increases memory usage and processing time; exceeding the device’s capacity may cause the app to terminate. The device recommendation is advised."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次请求中模型可处理内容的上限，按 token 计，包括输入与输出。数值越大，可保留的对话越长，但内存占用与处理时间相应增加；超出设备承载能力时，应用可能异常退出。建议采用“本机建议”值。"
          }
        }
      }
    },
    "help.autoCompress" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the conversation approaches the context limit, earlier turns are condensed into a summary so that the conversation can continue. Summaries may omit details. When disabled, the earliest turns are discarded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话接近上下文上限时，较早的对话内容将被压缩为摘要，以便对话继续进行。摘要可能遗漏部分细节。关闭后，将直接舍弃最早的对话内容。"
          }
        }
      }
    },
    "help.modelMaximum" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum context length supported by the model’s design. Device memory usually does not permit this length; the device recommendation applies in practice."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型设计所支持的最大上下文长度。受设备内存限制，通常无法达到该长度，实际应以“本机建议”值为准。"
          }
        }
      }
    },
    "help.deviceRecommendation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A context length at which this device can operate reliably, estimated from the model’s memory usage and the memory currently available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据模型内存占用与当前可用内存估算得出的、本机可稳定运行的上下文长度。"
          }
        }
      }
    },
    "help.kvCache" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The memory required to retain conversation context, expressed per 1,000 tokens of context."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型保存对话上下文所需的内存，以每 1000 个 token 为单位计算。"
          }
        }
      }
    },
    "help.mmap" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model weights are stored in a cache file and read on demand rather than loaded entirely into memory. This reduces memory usage and the risk of termination, at the cost of slightly slower loading. Takes effect after the model is reloaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将模型权重存放于本地缓存文件中并按需读取，而非全部载入内存。可降低内存占用及异常退出的风险，但加载速度可能略有下降。修改后需重新加载模型方可生效。"
          }
        }
      }
    },
    "help.clearMmap" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes the cache files created by mmap to free storage. The files are regenerated the next time the model is loaded, which lengthens that load."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 mmap 生成的缓存文件以释放存储空间。下次加载模型时将重新生成该文件，加载时间相应延长。"
          }
        }
      }
    },
    "help.thinking" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the model performs step-by-step reasoning, shown in a collapsible panel, before answering. Accuracy on complex questions improves, while response time and token usage increase. When disabled, the model answers directly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，模型将先进行推理（推理过程可折叠查看），再给出答案。复杂问题的准确性有所提升，但响应时间与 token 消耗相应增加。关闭后，模型将直接作答。"
          }
        }
      }
    },
    "help.backend" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hardware used to run the model. CPU offers the widest compatibility. Metal uses the GPU and is generally faster; the first load compiles shaders and may take about one minute. NPU uses the Neural Engine through Core ML and is supported by some models only. Takes effect after the model is reloaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行模型所使用的硬件。CPU：兼容性最佳；Metal：使用 GPU 计算，通常速度更快，首次加载需编译着色器，耗时约 1 分钟；NPU：通过 Core ML 使用神经网络引擎，仅部分模型支持。修改后需重新加载模型方可生效。"
          }
        }
      }
    },
    "help.precision" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The numeric precision used in computation. Low is faster, uses less memory, and suits most models. High is recommended only when a model produces garbled or abnormal output. Takes effect after the model is reloaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计算所采用的数值精度。Low（低）速度更快、内存占用更低，适用于大多数模型；仅当模型输出乱码或异常时，建议改用 High（高）。修改后需重新加载模型方可生效。"
          }
        }
      }
    },
    "help.threads" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number of threads used for CPU computation. A moderate increase may improve speed, whereas an excessive number raises device temperature and affects other apps. The default value is recommended. Takes effect after the model is reloaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 CPU 计算时的并行线程数。适度增加可提升速度，线程过多则会导致设备发热并影响其他应用的运行。建议保持默认值。修改后需重新加载模型方可生效。"
          }
        }
      }
    },
    "help.maxTokens" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum number of tokens in a single response, approximately its length in characters. Increase the value if responses are truncated; decrease it to obtain shorter responses. In thinking mode, reasoning content is included in this limit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次回答可生成的 token 数上限，约等于回答字数。回答被截断时可适当调高，需要更简短的回答时可适当调低。开启思考模式时，推理内容同样计入该上限。"
          }
        }
      }
    },
    "help.videoFrames" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number of frames sampled evenly from a video, at about one frame per second up to this limit, and provided to the model as images. More frames improve comprehension but increase processing time and memory usage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送视频时，从视频中均匀抽取并作为图片提供给模型的画面数量（约每秒 1 帧，不超过该上限）。帧数越多，理解越完整，但处理时间与内存占用相应增加。"
          }
        }
      }
    },
    "help.multimodalPrompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The prompt attached automatically when an image, video, or recording is sent without accompanying text, for example “Describe this image.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅发送图片、视频或语音而未输入文字时，系统自动附加的提示内容，例如“描述这张图片”。"
          }
        }
      }
    },
    "help.audioOutput" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For models with speech output, such as Qwen2.5-Omni, responses are read aloud in addition to being displayed as text."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，支持语音输出的模型（如 Qwen2.5-Omni）将在显示文字回答的同时进行语音播报。"
          }
        }
      }
    },
    "help.speaker" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The voice used for spoken responses."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音播报所使用的音色。"
          }
        }
      }
    },
    "help.iterations" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number of denoising steps used to generate an image. More steps generally yield finer detail, and generation time increases proportionally."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成图片时的去噪步数。步数越多，细节通常越丰富，生成时间也成比例增加。"
          }
        }
      }
    },
    "help.randomSeed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, each generation uses a new random seed, so the same prompt produces different images. When disabled, a seed can be specified manually."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，每次生成均使用新的随机种子，相同的描述将生成不同的图片。关闭后可手动指定种子。"
          }
        }
      }
    },
    "help.seed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The random starting point of generation. With the same seed and identical settings, the same image is reproduced."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成过程的随机初始值。种子及其他设置均相同时，将生成相同的图片，便于复现结果。"
          }
        }
      }
    },
    "help.sampler" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determines how the model selects the next token from its candidates. Mixed (default) combines several methods to balance quality and diversity and can be adjusted below. Greedy always selects the most probable token, producing stable and reproducible output that may be monotonous or repetitive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "决定模型从候选词中选取下一个词的方式。Mixed（默认）组合多种方法，兼顾质量与多样性，可在下方调整；Greedy 始终选取概率最高的词，结果稳定且可复现，但内容可能单一或重复。"
          }
        }
      }
    },
    "help.temperature" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controls the randomness of the output. A lower value, such as 0.2, yields more consistent and conservative responses suited to factual questions and code. A higher value, above 1.0, increases creativity but may reduce coherence."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制输出的随机程度。数值较低（如 0.2）时，回答更稳定、保守，适用于事实问答与代码编写；数值较高（1.0 以上）时，回答更具创造性，但连贯性可能下降。"
          }
        }
      }
    },
    "help.topK" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At each step, only the K most probable candidate tokens are considered. A smaller K yields more focused output; a larger K yields more diverse output."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一步仅在概率最高的 K 个候选词中进行选取。K 越小，输出越集中；K 越大，输出越多样。"
          }
        }
      }
    },
    "help.topP" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the most probable candidates whose cumulative probability reaches P are considered (nucleus sampling). A smaller P is more conservative; values of 0.8–0.95 are common."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在累计概率达到 P 的高概率候选词中进行选取（核采样）。P 越小，输出越保守；常用取值为 0.8–0.95。"
          }
        }
      }
    },
    "help.minP" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Candidates with a probability below P are excluded, removing clearly unsuitable choices. A larger P is more conservative."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排除概率低于 P 的候选词，以过滤明显不适宜的选项。P 越大，输出越保守。"
          }
        }
      }
    },
    "help.tfs" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tail-free sampling removes low-probability candidates from the tail of the distribution. Smaller values remove more candidates; 1.0 disables trimming."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尾部自由采样：移除概率分布尾部的低概率候选词。数值越小，移除的候选词越多；1.0 表示不进行裁剪。"
          }
        }
      }
    },
    "help.typical" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typical sampling retains candidates whose information content is close to the expected level, excluding both overly predictable and overly unlikely choices. Smaller values are stricter; 1.0 disables it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "典型采样：保留信息量接近期望水平的候选词，排除过于平常或过于罕见的选项。数值越小，筛选越严格；1.0 表示不启用。"
          }
        }
      }
    },
    "help.penalty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repetition penalty lowers the probability of tokens that have already appeared, reducing repetitive output. A value of 1.0 applies no penalty; 1.05–1.2 is a suitable starting range. An excessive value may impair fluency."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复惩罚：降低已出现词语再次出现的概率，以减少重复内容。1.0 表示不施加惩罚，建议从 1.05–1.2 开始尝试；数值过大可能影响语句通顺。"
          }
        }
      }
    },
    "help.ngramSize" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum phrase length considered in repetition detection. Repeated longer phrases receive a stronger penalty."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复检测所考虑的最大词组长度，重复出现的较长词组将受到更强的惩罚。"
          }
        }
      }
    },
    "help.ngramFactor" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An additional penalty multiplier for repeated phrases; longer matches receive a heavier penalty. A value of 1.0 applies no additional penalty."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对重复词组施加的额外惩罚倍数，重复词组越长，惩罚越重。1.0 表示不施加额外惩罚。"
          }
        }
      }
    },
    "help.penaltySampler" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selection method applied after the repetition penalty: Greedy selects the most probable token; Temperature samples randomly according to the temperature setting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "施加重复惩罚后最终选词所采用的方法：Greedy 选取概率最高的词；Temperature 按温度设置进行随机选取。"
          }
        }
      }
    },
    "help.mixed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Mixed mode, the enabled methods filter the candidates in the listed order, after which the next token is selected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixed 模式下，已启用的方法按列表顺序依次筛选候选词，随后选出下一个词。"
          }
        }
      }
    },
    "agent.mode" : {
      "extractionState" : "manual",
      "localizations" : {
