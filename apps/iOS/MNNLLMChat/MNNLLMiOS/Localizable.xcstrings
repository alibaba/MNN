          }
        }
      }
    },
    "privacy.sharing.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exported conversations, saved media, and shared feedback leave the app only through the actions you choose. The feedback form includes your description, app version, and iOS version; it does not automatically attach conversations or model inputs. Review the content and recipient before sharing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出的对话、保存的媒体及反馈内容通过你主动选择的操作分享。反馈表单包含你填写的描述、应用版本和 iOS 版本，不会自动附加聊天记录或模型输入。分享前请确认内容与接收对象。"
          }
        }
      }
    },
    "privacy.sharing.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing and feedback"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享与反馈"
          }
        }
      }
    },
    "privacy.storage.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats, model files, and settings are stored in the app on your device. Delete chats from the history list and downloaded models from the model list. The app does not provide its own cloud chat sync; device backups follow your system settings. Model downloads may use temporary files and additional space."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊天记录、模型文件与设置保存在设备的应用数据中。你可以在历史列表删除对话，在模型列表删除已下载模型。应用不提供自己的云端聊天同步；设备备份遵循你的系统设置。下载模型可能产生临时文件并需要额外空间。"
          }
        }
      }
    },
