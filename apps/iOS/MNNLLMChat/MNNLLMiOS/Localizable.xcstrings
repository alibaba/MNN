    "context.settings.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bar shows this request’s input plus generated tokens, including thinking. With conversation context enabled, the next request retains user messages, final answers and summaries, and omits earlier thinking, so the count may decrease. Near the budget, older turns are summarized on device; summaries may omit details. The model’s nominal limit differs from this phone’s available capacity. Recommendations use model cache size, prefill workspace and current app memory headroom, with a reserve for normal use. Completed replies help refine the estimate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度条显示本轮输入与生成的 token，包含思考。开启连续对话后，下一轮保留提问、正式回答和摘要，不带入之前的思考，因此计数可能下降。接近预算时，在本机压缩较早对话；摘要可能遗漏细节。模型标称上限不代表手机可运行长度，建议值结合模型缓存、处理输入的临时内存和当前 App 内存余量，保留运行空间，并参考实际生成的峰值修正。"
          }
        }
      }
    },
