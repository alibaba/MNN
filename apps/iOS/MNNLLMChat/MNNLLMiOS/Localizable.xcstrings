    "privacy.permissions.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos and the camera are used for media you choose to send to a supported local model. The microphone is used for voice input. You can change these permissions in iOS Settings and continue using text chat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片与相机用于你选择发送给受支持本地模型的媒体，麦克风用于语音输入。你可以在 iOS 设置中调整这些权限，并继续使用文字聊天。"
          }
        }
      }
    },
