      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long conversations, larger models, and thinking mode need more work. Stop the response, start a new chat, or try a smaller model. If the device is hot, let it cool before continuing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
