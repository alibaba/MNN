    "privacy.local.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local model processes your messages and supported images, audio, and videos on your device. The app does not send these inputs to a cloud AI service to generate answers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地模型在设备上处理你输入的文字及受支持的图片、音频和视频。应用不会为了生成回答将这些输入发送给云端 AI 服务。"
          }
        }
      }
    },
    "privacy.local.title" : {
      "extractionState" : "manual",
      "localizations" : {
