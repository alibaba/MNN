        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地对话"
          }
        }
      }
    },
    "privacy.network.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app connects to an online catalog and your selected model source, such as Hugging Face, ModelScope, or Modelers, to list and download models. Those services receive the requests and network information needed for the download, and apply their own privacy policies. Downloaded text models can be used offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会联网获取模型目录，并从你选择的 Hugging Face、ModelScope 或 Modelers 等下载源获取模型。相关服务会接收下载请求及所需的网络信息，并按各自的隐私政策处理。文字模型下载完成后可以离线使用。"
          }
        }
      }
    },
    "privacy.network.title" : {
