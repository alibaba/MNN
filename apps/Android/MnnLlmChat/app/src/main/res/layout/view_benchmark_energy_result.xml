<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/energy_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.alibaba.mnnllm.android.benchmark.PerformanceMetricView
            android:id="@+id/energy_per_round_metric"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1" />

        <com.alibaba.mnnllm.android.benchmark.PerformanceMetricView
            android:id="@+id/energy_average_power_metric"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/energy_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textColor="@color/benchmark_energy_caution"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/energy_details_toggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="0dp"
            android:text="@string/benchmark_energy_show_details"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:icon="@drawable/baseline_arrow_drop_down_24"
            app:iconGravity="end"
            app:iconPadding="0dp"
            app:iconSize="20dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/energy_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/performance_metric_background"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone" />
</LinearLayout>
