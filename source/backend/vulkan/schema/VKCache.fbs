namespace VKCache;

attribute "priority";

table WorkSize {
    x: uint;
    y: uint;
    z: uint;
}

table TuneInfo {
    shaderName: string;
    gws: WorkSize;
    optimalLws: WorkSize;
    optimalCost: float;
}

table TuneInfoCache {
    TuneInfos: [TuneInfo];
    // Serialized VkPipelineCache data (driver-owned blob; ignored on UUID/driver mismatch).
    PipelineCache: [ubyte];
}

root_type TuneInfoCache;
